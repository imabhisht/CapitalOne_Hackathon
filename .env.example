# Environment variables for the hackathon project
# Copy this file to .env and fill in your actual API keys

# WeatherAPI.com API Key
# Sign up at https://www.weatherapi.com/signup.aspx to get your free API key
WEATHERAPI_KEY=your_weatherapi_key_here

# Google Maps API Key (for geocoding in commodity tool)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# CEDA API Key (for commodity prices)
CEDA_API_KEY=your_ceda_api_key_here

# EXA API Key
EXA_API_KEY=your_exa_api_key_here

# MongoDB configuration
MONGODB_URI=your_mongodb_connection_string_here

# Port configuration
PORT=3000

# OpenRouter configuration
OPENROUTER_MODEL=your_openrouter_model_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

GOOGLE_MAPS_API_KEY=
CEDA_API_KEY=